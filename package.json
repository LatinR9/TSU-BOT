{
  "name": "tsu-bot-pro",
  "version": "1.0.0",
  "description": "TSU MOOC & Course Automation Suite with Multi-Browser & Auto-Quiz",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"test/*.test.js\" && node test/hit_rate.js --min 0.99",
    "build:exe": "npx -y @yao-pkg/pkg . --targets node18-win-x64 --output dist/TSU-BOT.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "tsu_answers.json",
      "tsu_answers.csv"
    ]
  },
  "keywords": [
    "tsu",
    "mooc",
    "automation",
    "playwright",
    "bot"
  ],
  "author": "LatinR9",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "playwright": "^1.44.0",
    "ws": "^8.17.0"
  }
}
